# 必須
RAINDROP_TOKEN=
# `claude setup-token` で発行(ローカルで claude にログイン済みなら省略可)
CLAUDE_CODE_OAUTH_TOKEN=
SLACK_WEBHOOK_URL=

# 任意
# RAINDROP_COLLECTION_ID=0      # 0 = 全コレクション(ゴミ箱除く)
# RAINDROP_TAG=tech             # 指定したタグが付いた記事だけ対象にする
# DIGEST_DATE=2026-09-27        # 対象日(日本時間)。未指定なら前日
# MAX_ARTICLES=20               # 1回のダイジェストに載せる最大件数
# ANTHROPIC_MODEL=sonnet          # Claude Code が使うモデル。未指定なら Claude Code の既定
# DRY_RUN=1                     # Slack 投稿・Markdown 書き出しをせず、結果を標準出力に出す

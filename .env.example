# 必須
RAINDROP_TOKEN=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# 任意
# RAINDROP_COLLECTION_ID=0      # 0 = 全コレクション(ゴミ箱除く)
# RAINDROP_TAG=tech             # 指定したタグが付いた記事だけ対象にする
# DIGEST_DAYS=7                 # 直近何日分のブックマークを対象にするか
# MAX_ARTICLES=20               # 1回のダイジェストに載せる最大件数
# ANTHROPIC_MODEL=claude-opus-5
# DRY_RUN=1                     # Slack に投稿せず Block Kit JSON を標準出力に出す
